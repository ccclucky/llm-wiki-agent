# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local credentials and workspace-specific state
.env
.env.*
!.env.example
.notion-sync-state.json
.notion-sync-state.json.tmp

# Private local intake and generated wiki data (this repository is public)
raw/*
!raw/.gitkeep
wiki/**/*.md
!wiki/index.md
!wiki/log.md
!wiki/overview.md
graph/*
!graph/.gitkeep

# Local reports and caches
*-report.md
*.local.json
